{
  "expo": {
    "name": "Passcard Store",
    "slug": "passcard-store",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "scheme": "passcardstore",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/logo.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B1120",
        "foregroundImage": "./assets/logo.png",
        "backgroundImage": "./assets/logo.png",
        "monochromeImage": "./assets/logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.mohdrafey1.passcardstore",
      "permissions": ["android.permission.USE_BIOMETRIC", "android.permission.USE_FINGERPRINT"],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "versionCode": 5,
      "allowBackup": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Manrope",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Manrope_400Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/Manrope_500Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/Manrope_600SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/Manrope_700Bold.ttf",
                    "weight": 700
                  },
                  {
                    "path": "./assets/fonts/Manrope_800ExtraBold.ttf",
                    "weight": 800
                  }
                ]
              },
              {
                "fontFamily": "JetBrains Mono",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/JetBrainsMono_500Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/JetBrainsMono_600SemiBold.ttf",
                    "weight": 600
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./assets/fonts/Manrope_400Regular.ttf",
              "./assets/fonts/Manrope_500Medium.ttf",
              "./assets/fonts/Manrope_600SemiBold.ttf",
              "./assets/fonts/Manrope_700Bold.ttf",
              "./assets/fonts/Manrope_800ExtraBold.ttf",
              "./assets/fonts/JetBrainsMono_500Medium.ttf",
              "./assets/fonts/JetBrainsMono_600SemiBold.ttf"
            ]
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1120",
          "image": "./assets/logo.png",
          "imageWidth": 120,
          "android": {
            "image": "./assets/logo.png",
            "imageWidth": 120,
            "backgroundColor": "#0B1120"
          }
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "expo-sqlite",
      "expo-local-authentication",
      "expo-document-picker",
      "expo-updates",
      "react-native-quick-crypto"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ef4ccf72-5ad3-4234-bad2-991dd9c96338",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ef4ccf72-5ad3-4234-bad2-991dd9c96338"
      }
    },
    "owner": "mohdrafey1"
  }
}
